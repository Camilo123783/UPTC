# ============================================================
# .gitignore — Backend Node.js / Express (UPTC)
# ============================================================

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno y secretos
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.token
*credentials.json

# Cargas dinámicas (mantener carpeta vacía)
uploads/*
!uploads/.gitkeep
*.tmp
*.temp

# Compilación y logs
dist/
build/
logs/
*.log

# Cobertura y testing
coverage/
.nyc_output/

# Editores y SO
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.bak
*.backup
*.dump
