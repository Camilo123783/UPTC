# ============================================================
# ⚙️  ENTORNO Y PUERTO (Render / Producción)
# ============================================================
NODE_ENV=production
PORT=10000

# ============================================================
# 🌐  ORIGEN DEL FRONTEND (Vercel)
# ============================================================
# Permite solicitudes CORS desde tu dominio en Vercel (o varios separados por comas)
FRONTEND_URL=https://tu-proyecto.vercel.app

# ============================================================
# 🗄️  BASE DE DATOS (MySQL Hostinger / Remota)
# ============================================================
# IMPORTANTE: En Hostinger, habilita "MySQL Remoto" con IP '%' para permitir Render.
DB_HOST=srv655.hstgr.io
DB_USER=u241712700_tu_usuario
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=u241712700_tu_base_datos
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=20000

# ============================================================
# 🔐  AUTENTICACIÓN (JWT)
# ============================================================
# Genera un secreto seguro con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_con_tu_clave_secreta_jwt_segura_de_64_caracteres
JWT_EXPIRES_IN=8h

# ============================================================
# 📧  CORREO INSTITUCIONAL Y NOTIFICACIONES (SMTP / HTTP API)
# ============================================================
ADMIN_EMAIL=tu_correo_institucional@uptc.edu.co
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion_16_caracteres

# Opciones recomendadas para la nube (Render Free Tier bloquea puertos SMTP 25, 465, 587):
# 1. Webhook Google Apps Script (Gratis, envía desde tu Gmail nativo sin bloqueos):
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
# 2. Brevo REST API (300 correos gratis/día sin bloquear puertos):
# BREVO_API_KEY=tu_api_key_de_brevo
# 3. Resend REST API (Recomendado para Render — HTTPS puerto 443):
RESEND_API_KEY=re_tu_api_key_de_resend
MAIL_FROM=onboarding@resend.dev

